# folio-cms environment. Copy to .env for local development (npm run dev).
# docker compose up works without this file: docker-compose.yml has the same defaults.

# PostgreSQL connection string.
# Inside docker compose the host is "db"; from your machine it is "localhost".
DATABASE_URL="postgresql://folio:folio@localhost:5432/folio"

# Secret used to sign session tokens. Local-only default below.
# For any real deployment generate your own: openssl rand -base64 32
AUTH_SECRET="local-dev-secret-change-me-in-production-0123456789"

# Public URL of the app, used for auth callbacks and links in logs.
AUTH_URL="http://localhost:3000"

# Public demo mode: shows a banner, prefills the demo login and blocks
# destructive changes to the demo account.
DEMO_MODE="false"

# Admin account created by the seed on first start (optional).
# Leave unset to use the public demo login: demo@folio-cms.dev / demo-password
# ADMIN_EMAIL="you@example.com"
# ADMIN_PASSWORD="a-long-password"
