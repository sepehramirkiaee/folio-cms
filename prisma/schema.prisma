// Data model for folio-cms. See README "Data model" for the reasoning behind it.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
}

enum SkillCategory {
  FRONTEND
  BACKEND
  DATA
  DEVOPS
  AI
  DESIGN
  OTHER
}

/// Admin accounts. Sessions are JWTs, so there are no Account or Session tables.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  /// The seeded demo account. Protected from destructive changes in demo mode.
  isDemo       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Singleton row (id is always 1) that feeds the home page intro.
model Profile {
  id          Int      @id @default(1)
  fullName    String
  headline    String
  bio         String   @db.Text
  location    String?
  email       String?
  githubUrl   String?
  linkedinUrl String?
  avatarUrl   String?
  updatedAt   DateTime @updatedAt
}

model Project {
  id            String        @id @default(cuid())
  slug          String        @unique
  title         String
  summary       String        @db.VarChar(280)
  body          String        @db.Text
  coverImageUrl String?
  liveUrl       String?
  repoUrl       String?
  year          Int?
  status        ProjectStatus @default(DRAFT)
  featured      Boolean       @default(false)
  /// Manual order set by drag-to-reorder in the admin. Lower comes first.
  sortOrder     Int
  skills        Skill[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status, featured, sortOrder])
  @@index([sortOrder])
}

model Experience {
  id         String    @id @default(cuid())
  company    String
  role       String
  location   String?
  companyUrl String?
  startDate  DateTime  @db.Date
  /// Null means this is the current role.
  endDate    DateTime? @db.Date
  summary    String    @db.Text
  highlights String[]
  skills     Skill[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([startDate(sort: Desc)])
}

model Skill {
  id          String        @id @default(cuid())
  name        String        @unique
  slug        String        @unique
  category    SkillCategory
  /// Shown in the skills section of the public home page.
  featured    Boolean       @default(true)
  projects    Project[]
  experiences Experience[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([category, name])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}
